---
import '../styles/global.css';
import { STORAGE_KEYS } from '../config';
import { homePath, url } from '../lib/paths';

const targets = { pl: homePath('pl'), en: homePath('en') };
const langKey = STORAGE_KEYS.lang;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terminarz Pucharu Świata w skokach narciarskich</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <script is:inline define:vars={{ targets, langKey }}>
      // Polish is the default; English only when the visitor chose it before.
      let lang = 'pl';
      try {
        if (localStorage.getItem(langKey) === 'en') {
          lang = 'en';
        }
      } catch {
        lang = 'pl';
      }
      location.replace(targets[lang]);
    </script>
  </head>
  <body>
    <main class="page">
      <ul class="language-list">
        <li>
          <a class="link" href={targets.pl} hreflang="pl">
            Polski
          </a>
        </li>
        <li>
          <a class="link" href={targets.en} hreflang="en">
            English
          </a>
        </li>
      </ul>
    </main>
  </body>
</html>
