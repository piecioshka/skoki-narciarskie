---
import NationsTable from '../../../components/NationsTable.astro';
import { LANGUAGES, t, type Lang } from '../../../i18n';
import Layout from '../../../layouts/Layout.astro';
import { CONTINENTS, getContinent, getNations } from '../../../lib/nations';
import { getLatestNationsCupSeason } from '../../../lib/nations-cup';
import { routeUrl } from '../../../lib/paths';
import { formatSeasonLabel } from '../../../lib/seasons';
import { getStandingsSeasons } from '../../../lib/standings';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const seasons = getStandingsSeasons();
const range = `${formatSeasonLabel(seasons[seasons.length - 1] ?? '')} - ${formatSeasonLabel(seasons[0] ?? '')}`;
const nations = getNations();
const nationsCupSeason = getLatestNationsCupSeason();
const groups = CONTINENTS.map((continent) => ({
  continent,
  nations: nations.filter((item) => getContinent(item.nation) === continent),
})).filter((group) => group.nations.length > 0);
---

<Layout
  lang={lang}
  title={dict.nationsTitle}
  description={dict.nationsLead(range)}
  route={{ name: 'nations' }}
>
  <section class="section" aria-labelledby="nations-title">
    <div class="section__header">
      <h2 class="section__title section__title--page" id="nations-title">
        {dict.nationsTitle}
      </h2>
      <button
        class="button js-view-toggle"
        type="button"
        aria-pressed="false"
        data-storage="nations-grouped"
        data-flat="#nations-flat"
        data-grouped="#nations-grouped"
      >
        {dict.groupByContinent}
      </button>
    </div>
    <p class="lead">{dict.nationsLead(range)}</p>
    {nationsCupSeason && (
      <p class="nations-cup-link">
        <a
          class="link"
          href={routeUrl(lang, {
            name: 'nations-cup',
            seasonId: nationsCupSeason,
          })}
        >
          {dict.nationsCupTitle(formatSeasonLabel(nationsCupSeason))}
        </a>
      </p>
    )}
    <div id="nations-flat">
      <NationsTable lang={lang} nations={nations} />
    </div>
    <div id="nations-grouped" hidden>
      {groups.map((group) => (
        <section class="country-group" data-continent={group.continent}>
          <h3 class="country-group__title">
            {dict.continents[group.continent]}
          </h3>
          <NationsTable lang={lang} nations={group.nations} />
        </section>
      ))}
    </div>
  </section>
</Layout>
