---
import { LANGUAGES, t, type Lang } from '../../../i18n';
import Layout from '../../../layouts/Layout.astro';
import { formatThousands } from '../../../lib/hills';
import { getNationFlag, getNationName } from '../../../lib/links';
import { getNations } from '../../../lib/nations';
import { nationPath } from '../../../lib/paths';
import { formatSeasonLabel } from '../../../lib/seasons';
import { getStandingsSeasons } from '../../../lib/standings';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const seasons = getStandingsSeasons();
const range = `${formatSeasonLabel(seasons[seasons.length - 1] ?? '')} - ${formatSeasonLabel(seasons[0] ?? '')}`;
---

<Layout
  lang={lang}
  title={dict.nationsTitle}
  description={dict.nationsLead(range)}
  path="/nations/"
>
  <section class="section" aria-labelledby="nations-title">
    <h2 class="section__title section__title--page" id="nations-title">
      {dict.nationsTitle}
    </h2>
    <p class="lead">{dict.nationsLead(range)}</p>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th class="table__cell" scope="col">
              {dict.country}
            </th>
            <th class="table__cell table__cell--number" scope="col">
              {dict.athletes}
            </th>
            <th class="table__cell table__cell--number" scope="col">
              {dict.crystalGlobes}
            </th>
            <th class="table__cell table__cell--number" scope="col">
              {dict.points}
            </th>
          </tr>
        </thead>
        <tbody>
          {getNations().map((nation) => (
            <tr class="table__row" data-nation={nation.nation}>
              <td class="table__cell">
                <a class="table__link" href={nationPath(lang, nation.nation)}>
                  {`${getNationFlag(nation.nation)} ${getNationName(lang, nation.nation)}`}
                </a>
              </td>
              <td class="table__cell table__cell--number">
                {nation.athletes.length}
              </td>
              <td class="table__cell table__cell--number">{nation.titles}</td>
              <td class="table__cell table__cell--number table__cell--strong">
                {formatThousands(nation.points)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Layout>
