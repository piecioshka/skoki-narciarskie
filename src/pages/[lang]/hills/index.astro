---
import HillTile from '../../../components/HillTile.astro';
import PlacesMap from '../../../components/PlacesMap.astro';
import { getCountryName, LANGUAGES, t, type Lang } from '../../../i18n';
import Layout from '../../../layouts/Layout.astro';
import {
  getAllHills,
  getHillProfileSlug,
  groupByLocation,
} from '../../../lib/hills';
import { hillPath } from '../../../lib/paths';
import { getFlag } from '../../../lib/links';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const hills = getAllHills();
const points = groupByLocation(hills).flatMap((point) => {
  const [first] = point.hills;

  return first
    ? [
        {
          label: `${first.name} ${point.hills.map((hill) => `HS${hill.hillSize}`).join(', ')}`,
          note: `${first.city}, ${getCountryName(lang, first.countryCode)}`,
          lat: point.lat,
          lon: point.lon,
          href: hillPath(lang, getHillProfileSlug(first)),
        },
      ]
    : [];
});
const countries = [...new Set(hills.map((hill) => hill.countryCode))]
  .map((code) => ({
    code,
    name: getCountryName(lang, code),
    hills: hills.filter((hill) => hill.countryCode === code),
  }))
  .sort((a, b) => a.name.localeCompare(b.name, lang));
---

<Layout
  lang={lang}
  title={dict.hillsTitle}
  description={dict.hillsLead}
  path="/hills/"
>
  <section class="section" aria-labelledby="hills-title">
    <div class="section__header">
      <h2 class="section__title section__title--page" id="hills-title">
        {dict.hillsTitle}
      </h2>
      <button class="button js-group-hills" type="button" aria-pressed="false">
        {dict.groupByCountry}
      </button>
    </div>
    <p class="lead">{dict.hillsLead}</p>
    <PlacesMap points={points} label={dict.hillsMap} />
    <ul class="tournament-list js-hills-flat">
      {hills.map((hill) => (
        <HillTile lang={lang} hill={hill} />
      ))}
    </ul>
    <div class="with-toc js-hills-grouped" hidden>
      <div class="with-toc__content">
        {countries.map((country) => (
          <section
            class="country-group js-toc-section"
            id={`country-${country.code.toLowerCase()}`}
            data-country={country.code}
          >
            <h3 class="country-group__title">
              {`${getFlag(country.code)} ${country.name}`}
            </h3>
            <ul class="tournament-list">
              {country.hills.map((hill) => (
                <HillTile lang={lang} hill={hill} />
              ))}
            </ul>
          </section>
        ))}
      </div>
      <nav class="toc" aria-label={dict.tocTitle}>
        <p class="toc__title">{dict.tocTitle}</p>
        <ul class="toc__list">
          {countries.map((country) => (
            <li>
              <a
                class="toc__link js-toc-link"
                href={`#country-${country.code.toLowerCase()}`}
              >
                {`${getFlag(country.code)} ${country.name}`}
                <span class="toc__count">{country.hills.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</Layout>
