---
import { Image } from 'astro:assets';
import { LANGUAGES, t, type Lang } from '../../../i18n';
import Layout from '../../../layouts/Layout.astro';
import {
  getAllHills,
  getHillPhoto,
  getHillProfileSlug,
} from '../../../lib/hills';
import { hillPath } from '../../../lib/paths';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
---

<Layout
  lang={lang}
  title={dict.hillsTitle}
  description={dict.hillsLead}
  path="/hills/"
>
  <section class="section" aria-labelledby="hills-title">
    <h2 class="section__title section__title--page" id="hills-title">
      {dict.hillsTitle}
    </h2>
    <p class="lead">{dict.hillsLead}</p>
    <ul class="tournament-list">
      {getAllHills().map((hill) => {
        const photo = getHillPhoto(hill);

        return (
          <li>
            <a
              class="tournament-card"
              href={hillPath(lang, getHillProfileSlug(hill))}
              data-hill={hill.slug}
            >
              {photo ? (
                <Image
                  class="hill-card__image"
                  src={photo}
                  width={480}
                  alt=""
                />
              ) : (
                <div class="hill-card__placeholder" />
              )}
              <div class="tournament-card__body">
                <h3 class="tournament-card__title">{hill.name}</h3>
                <p class="tournament-card__meta">
                  <span class="badge">HS{hill.hillSize}</span>
                  <span class="phase">K{hill.kPoint}</span>
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Layout>
