---
import { Image } from 'astro:assets';
import Icon from '../../../components/Icon.astro';
import PosterChrome from '../../../components/PosterChrome.astro';
import SlotTime from '../../../components/SlotTime.astro';
import { getCountryName, LANGUAGES, t, type Lang } from '../../../i18n';
import Layout from '../../../layouts/Layout.astro';
import {
  formatHillSize,
  formatNumber,
  getHillPhoto,
  hillOfCompetition,
} from '../../../lib/hills';
import { getFlag } from '../../../lib/links';
import { findNext, listScheduled, timingAttributes } from '../../../lib/timing';
import { formatSeasonLabel, getCurrentSeason } from '../../../lib/seasons';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = t(lang);
const season = getCurrentSeason();
const competitions = listScheduled(season, { withTraining: false });
// Only a no-JS fallback; the client script picks the poster on every tick.
const buildTimeNext = findNext(competitions, new Date());
const posters = competitions.map((item) => {
  const hill = hillOfCompetition(item.event, item.competition);

  return {
    ...item,
    hill,
    photo: hill ? getHillPhoto(hill) : undefined,
    // The poster shown without JS; the others get their shared parts from
    // the templates below when the page script shows them.
    shown: item.slot === buildTimeNext?.slot,
  };
});
---

<Layout
  lang={lang}
  route={{ name: 'countdown' }}
  title={dict.posterTitle}
  description={dict.posterLead}
>
  <section class="section" aria-labelledby="poster-title">
    <div class="section__header">
      <h2 class="section__title" id="poster-title">
        {dict.posterTitle}
      </h2>
      <div class="poster-formats" role="group" aria-label={dict.posterFormat}>
        {(['wide', 'story'] as const).map((format) => (
          <button
            class="button js-poster-format"
            type="button"
            data-format={format}
            aria-pressed={format === 'wide' ? 'true' : 'false'}
          >
            {dict.posterFormats[format]}
          </button>
        ))}
      </div>
    </div>
    <p class="lead">{dict.posterLead}</p>

    <div class="poster-stage js-poster-stage" data-format="wide">
      {posters.map((item) => (
        <article
          class="poster js-poster"
          hidden={!item.shown}
          {...timingAttributes(item.competition, item.slot)}
          data-race={item.competition.fisRaceId}
          data-event={item.event.slug}
        >
          {item.photo && (
            <Image
              class="poster__photo"
              src={item.photo}
              width={1600}
              alt=""
              loading="eager"
            />
          )}
          {item.shown && <PosterChrome lang={lang} part="backdrop" />}

          <div class="poster__body">
            <p class="poster__kicker">
              {dict.types[item.event.type]} {formatSeasonLabel(season.id)}
            </p>
            <h3
              class:list={[
                'poster__city',
                {
                  'poster__city--long': item.event.city.length > 8,
                  'poster__city--xlong': item.event.city.length > 12,
                },
              ]}
            >
              <span
                class="poster__flag"
                role="img"
                aria-label={getCountryName(lang, item.event.countryCode)}
              >
                {getFlag(item.event.countryCode)}
              </span>
              <span class="poster__city-name">{item.event.city}</span>
            </h3>
            <p class="poster__kind">
              <span class="poster__kind-name">
                {dict.kinds[item.competition.kind]}
              </span>
              {item.hill && (
                <span class="poster__hill">
                  {item.hill.name} · {formatHillSize(item.hill)}
                </span>
              )}
            </p>

            {item.shown && <PosterChrome lang={lang} part="clock" />}

            <p class="poster__start">
              <span class="poster__start-label">{dict.posterStartsAt}</span>{' '}
              <SlotTime
                lang={lang}
                competition={item.competition}
                timeSlot={item.slot}
              />
            </p>
            {item.hill?.record && (
              <p class="poster__record">
                {dict.posterRecord}:{' '}
                <strong class="poster__record-value">
                  {formatNumber(item.hill.record.distance, lang)} m
                </strong>{' '}
                {item.hill.record.athlete} ({item.hill.record.nation}) ·{' '}
                <span class="poster__record-date">{item.hill.record.date}</span>
              </p>
            )}

            {item.shown && <PosterChrome lang={lang} part="footer" />}
          </div>
        </article>
      ))}
    </div>
    {(['backdrop', 'clock', 'footer'] as const).map((part) => (
      <template class="js-poster-part" data-part={part}>
        <PosterChrome lang={lang} part={part} />
      </template>
    ))}
    <div class="poster-export" hidden={buildTimeNext === undefined}>
      <button
        class="button button--primary js-poster-export"
        type="button"
        data-kind="image"
        data-idle={dict.posterExport.image}
        data-busy={dict.posterExport.imageBusy}
        data-done={dict.posterExport.done}
        data-failed={dict.posterExport.failed}
      >
        <Icon name="download" class="poster-export__idle" />
        <Icon name="loader" class="poster-export__spinner" />
        <span class="js-poster-export-label">{dict.posterExport.image}</span>
      </button>
      <button
        class="button js-poster-export"
        type="button"
        data-kind="copy"
        data-idle={dict.posterExport.copy}
        data-busy={dict.posterExport.copyBusy}
        data-done={dict.posterExport.copied}
        data-failed={dict.posterExport.copyFailed}
        data-unsupported={dict.posterExport.copyUnsupported}
      >
        <Icon name="copy" class="poster-export__idle" />
        <Icon name="loader" class="poster-export__spinner" />
        <span class="js-poster-export-label">{dict.posterExport.copy}</span>
      </button>
      <button
        class="button js-poster-export"
        type="button"
        data-kind="video"
        data-idle={dict.posterExport.video}
        data-busy={dict.posterExport.videoBusy}
        data-done={dict.posterExport.done}
        data-failed={dict.posterExport.failed}
        data-unsupported={dict.posterExport.unsupported}
      >
        <Icon name="video" class="poster-export__idle" />
        <Icon name="loader" class="poster-export__spinner" />
        <span class="js-poster-export-label">{dict.posterExport.video}</span>
      </button>
      <p
        class="poster-export__status js-poster-export-status"
        role="status"
      ></p>
    </div>
    <p class="notice js-season-over" hidden={buildTimeNext !== undefined}>
      {dict.seasonOver}
    </p>
    <p class="note">
      {dict.timeZoneNote} <span class="js-time-zone">Europe/Warsaw</span>
    </p>
  </section>
</Layout>
