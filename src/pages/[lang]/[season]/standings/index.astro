---
import SeasonSwitch from '../../../../components/SeasonSwitch.astro';
import StandingsTable from '../../../../components/StandingsTable.astro';
import { LANGUAGES, t, type Lang } from '../../../../i18n';
import Layout from '../../../../layouts/Layout.astro';
import { getNationsCupSeasons } from '../../../../lib/nations-cup';
import { routeUrl } from '../../../../lib/paths';
import { formatSeasonLabel } from '../../../../lib/seasons';
import { getStandings, getStandingsSeasons } from '../../../../lib/standings';

// Standings reach further back than the schedules, so the pages follow the
// standings files instead of the season files.
export function getStaticPaths() {
  return LANGUAGES.flatMap((lang) =>
    getStandingsSeasons().map((seasonId) => ({
      params: { lang, season: seasonId },
      props: { lang, seasonId },
    })),
  );
}

interface Props {
  lang: Lang;
  seasonId: string;
}

const { lang, seasonId } = Astro.props;
const dict = t(lang);
const title = dict.standingsTitle(formatSeasonLabel(seasonId));
const standings = getStandings(seasonId);
const hasRows = standings !== undefined && standings.rows.length > 0;
// FIS publishes the Nations Cup only for recent seasons.
const hasNationsCup = getNationsCupSeasons().includes(seasonId);
---

<Layout
  lang={lang}
  title={title}
  description={`${title}. ${dict.standingsLead}`}
  route={{ name: 'standings', seasonId }}
>
  <section class="section" aria-labelledby="standings-title">
    <h2 class="section__title section__title--page" id="standings-title">
      {title}
    </h2>
    <p class="lead">{dict.standingsLead}</p>
    {hasNationsCup && (
      <p class="nations-cup-link">
        <a
          class="link"
          href={routeUrl(lang, { name: 'nations-cup', seasonId })}
        >
          {dict.nationsCupTitle(formatSeasonLabel(seasonId))}
        </a>
      </p>
    )}
    <SeasonSwitch
      lang={lang}
      seasons={getStandingsSeasons()}
      current={seasonId}
      route={(id) => ({ name: 'standings', seasonId: id })}
    />
    {hasRows ? (
      <StandingsTable lang={lang} standings={standings} />
    ) : (
      <p class="notice">{dict.standingsEmpty}</p>
    )}
  </section>
</Layout>
