---
import StandingsTable from '../../../../components/StandingsTable.astro';
import { LANGUAGES, t, type Lang } from '../../../../i18n';
import Layout from '../../../../layouts/Layout.astro';
import { standingsPath } from '../../../../lib/paths';
import { formatSeasonLabel } from '../../../../lib/seasons';
import {
  getPreviousStandings,
  getStandings,
  getStandingsSeasons,
} from '../../../../lib/standings';

// Standings reach further back than the schedules, so the pages follow the
// standings files instead of the season files.
export function getStaticPaths() {
  return LANGUAGES.flatMap((lang) =>
    getStandingsSeasons().map((seasonId) => ({
      params: { lang, season: seasonId },
      props: { lang, seasonId },
    })),
  );
}

interface Props {
  lang: Lang;
  seasonId: string;
}

const { lang, seasonId } = Astro.props;
const dict = t(lang);
const title = dict.standingsTitle(formatSeasonLabel(seasonId));
const standings = getStandings(seasonId);
const hasRows = standings !== undefined && standings.rows.length > 0;
const previous = hasRows ? undefined : getPreviousStandings(seasonId);
---

<Layout
  lang={lang}
  title={title}
  description={`${title}. ${dict.standingsLead}`}
  path={`/${seasonId}/standings/`}
>
  <section class="section" aria-labelledby="standings-title">
    <h2 class="section__title section__title--page" id="standings-title">
      {title}
    </h2>
    <p class="lead">{dict.standingsLead}</p>
    <nav class="season-switch" aria-label={dict.otherSeasons}>
      {getStandingsSeasons().map((id) => (
        <a
          class="season-switch__link"
          href={standingsPath(lang, id)}
          aria-current={id === seasonId ? 'page' : undefined}
        >
          {formatSeasonLabel(id)}
        </a>
      ))}
    </nav>
    {hasRows ? (
      <StandingsTable lang={lang} standings={standings} />
    ) : (
      <p class="notice">{dict.standingsEmpty}</p>
    )}
  </section>

  {previous && (
    <section class="section" aria-labelledby="previous-title">
      <h3 class="section__title" id="previous-title">
        {dict.standingsPrevious(formatSeasonLabel(previous.season))}
      </h3>
      <StandingsTable lang={lang} standings={previous} />
    </section>
  )}
</Layout>
