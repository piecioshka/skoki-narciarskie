---
import { LANGUAGES, t, type Lang } from '../../../../i18n';
import { nationPath } from '../../../../lib/paths';
import { getSeasons } from '../../../../lib/seasons';
import { getTeams } from '../../../../lib/standings';

// The team moved to the page of the Polish nation; this address only redirects.
export function getStaticPaths() {
  return LANGUAGES.flatMap((lang) =>
    getSeasons()
      .filter((season) => getTeams(season.id) !== undefined)
      .map((season) => ({
        params: { lang, season: season.id },
        props: { lang },
      })),
  );
}

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const target = nationPath(lang, 'POL');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{t(lang).teamTitle('')}</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
  </head>
  <body>
    <a href={target}>{t(lang).teamTitle('')}</a>
  </body>
</html>
