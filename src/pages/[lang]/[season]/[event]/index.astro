---
import Avatar from '../../../../components/Avatar.astro';
import Badges from '../../../../components/Badges.astro';
import CompetitionLinks from '../../../../components/CompetitionLinks.astro';
import Icon from '../../../../components/Icon.astro';
import SlotTime from '../../../../components/SlotTime.astro';
import { getCountryName, LANGUAGES, t, type Lang } from '../../../../i18n';
import Layout from '../../../../layouts/Layout.astro';
import {
  getFisEventUrl,
  getFlag,
  getNationCountryCode,
  getNationFlag,
  getAthleteUrl,
} from '../../../../lib/links';
import HillCard from '../../../../components/HillCard.astro';
import PastWinners from '../../../../components/PastWinners.astro';
import {
  competitionHillLabel,
  describeEventHill,
  getEventHills,
} from '../../../../lib/hills';
import { getPrograms } from '../../../../lib/programs';
import ProgramCard from '../../../../components/ProgramCard.astro';
import PersonName from '../../../../components/PersonName.astro';
import { toPersonKey } from '../../../../lib/people';
import { getTeams } from '../../../../lib/standings';
import { seasonPath, tournamentPath } from '../../../../lib/paths';
import { getEventTournaments } from '../../../../lib/tournaments';
import type { Season, SeasonEvent } from '../../../../lib/schema';
import {
  getEventEnd,
  getEventRange,
  groupByDay,
} from '../../../../lib/schedule';
import { getSlot, timingAttributes } from '../../../../lib/timing';
import { formatSeasonLabel, getSeasons } from '../../../../lib/seasons';

export function getStaticPaths() {
  return LANGUAGES.flatMap((lang) =>
    getSeasons().flatMap((season) =>
      season.events.map((event) => ({
        params: { lang, season: season.id, event: event.slug },
        props: { lang, season, event },
      })),
    ),
  );
}

interface Props {
  lang: Lang;
  season: Season;
  event: SeasonEvent;
}

const { lang, season, event } = Astro.props;
const dict = t(lang);
const range = getEventRange(event);
const days = groupByDay(event);
const hills = getEventHills(event);
const nationName = (nation: string): string => {
  const countryCode = getNationCountryCode(nation);

  return countryCode ? getCountryName(lang, countryCode) : nation;
};
const tournaments = getEventTournaments(season.id, event.slug);
const programs = getPrograms(season.id).filter(
  (program) => program.eventSlug === event.slug,
);
const country = getCountryName(lang, event.countryCode);
// A Wikipedia link from the squad data wins over the FIS biography.
const squadLinks = new Map(
  (getTeams(season.id, 'POL')?.teams ?? [])
    .flatMap((team) => team.athletes)
    .flatMap((athlete): [string, string][] =>
      athlete.url ? [[toPersonKey(athlete.name), athlete.url]] : [],
    ),
);
const athleteUrl = (athlete: { name: string; fisCompetitorId: number }) =>
  squadLinks.get(toPersonKey(athlete.name)) ??
  getAthleteUrl(athlete.fisCompetitorId);
const hillText = describeEventHill(event, dict.hillTypes);
const title = `${event.city} ${formatSeasonLabel(season.id)}`;
const description = `${dict.types[event.type]}: ${event.city} (${country}), ${range.start} - ${range.end}. ${hillText}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${dict.types[event.type]}: ${event.city}`,
  sport: 'Ski jumping',
  startDate: range.start,
  endDate: getEventEnd(event).toISOString(),
  eventStatus: 'https://schema.org/EventScheduled',
  location: {
    '@type': 'Place',
    name: event.hillName ?? event.city,
    address: {
      '@type': 'PostalAddress',
      addressLocality: event.city,
      addressCountry: event.countryCode,
    },
  },
};
---

<Layout
  lang={lang}
  title={title}
  description={description}
  path={`/${season.id}/${event.slug}/`}
  jsonLd={jsonLd}
>
  <a class="link back-link" href={seasonPath(lang, season.id)}>
    <Icon name="arrow-left" />
    {dict.backToSchedule}
  </a>

  <header class="event-header">
    <div class="event-header__badges">
      <span class="badge badge--type">{dict.types[event.type]}</span>
      <Badges lang={lang} event={event} />
    </div>
    <h2 class="event-header__title">
      <span role="img" aria-label={country}>
        {getFlag(event.countryCode)}
      </span>
      {event.city}
    </h2>
    <p class="event-header__meta">
      {[country, hillText].filter(Boolean).join(' · ')}
    </p>
    {tournaments.map((tournament) => (
      <p class="event-header__meta">
        {dict.partOf}:{' '}
        <a class="link" href={tournamentPath(lang, tournament.slug)}>
          {tournament.name}
        </a>
      </p>
    ))}
    <p class="event-header__meta">
      <a class="link" href={getFisEventUrl(season, event)}>
        {dict.fisEventPage}
      </a>
      {(event.documents ?? []).map((document) => (
        <>
          {' · '}
          <a class="link" href={document.url}>
            {dict.documentLabels[document.label] ?? document.label} (PDF)
          </a>
        </>
      ))}
    </p>
  </header>

  <section class="section" aria-labelledby="program-title">
    <h3 class="section__title" id="program-title">
      {dict.program}
    </h3>
    {days.map((day) => (
      <div class="day">
        <h4 class="day__title">{day.date}</h4>
        <ul class="competition-list">
          {day.competitions.map((competition) => {
            const slot = getSlot(event, competition);

            return (
              <li
                class:list={[
                  'competition',
                  competition.status === 'cancelled' &&
                    'competition--cancelled',
                  competition.polishAthletes.length > 0 &&
                    'competition--athletes',
                ]}
                {...timingAttributes(competition, slot)}
                data-race={competition.fisRaceId}
              >
                <div class="competition__info">
                  <span class="competition__time">
                    <SlotTime
                      lang={lang}
                      competition={competition}
                      timeSlot={slot}
                    />
                  </span>
                  <span class="competition__kind">
                    {dict.kinds[competition.kind]}
                    <span class="competition__hill">
                      {competitionHillLabel(event, competition, dict.hillTypes)}
                    </span>
                  </span>
                  {competition.status === 'scheduled' ? (
                    <span class="phase js-phase">{dict.phases.upcoming}</span>
                  ) : (
                    <span class="phase phase--alert">
                      {dict.statuses[competition.status]}
                    </span>
                  )}
                </div>
                {competition.results.length > 0 && (
                  <ol class="podium" aria-label={dict.podium}>
                    {competition.results.map((place) => (
                      <li class="podium__place">
                        <span class="podium__rank">{place.rank}.</span>
                        {place.name && <Avatar name={place.name} />}
                        {getNationFlag(place.nation)}{' '}
                        {place.name ?? nationName(place.nation)}
                      </li>
                    ))}
                  </ol>
                )}
                {competition.polishAthletes.length > 0 && (
                  <div class="athletes">
                    <p class="athletes__title">
                      {`${dict.polishAthletes} (${competition.polishAthletes.length})`}
                    </p>
                    <ul class="people athletes__list">
                      {competition.polishAthletes.map((athlete) => (
                        <li class="people__item">
                          <PersonName
                            name={athlete.name}
                            url={athleteUrl(athlete)}
                          />
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                <CompetitionLinks
                  lang={lang}
                  season={season}
                  event={event}
                  competition={competition}
                  broadcastsLast
                >
                  {competition.status === 'scheduled' && slot.timed && (
                    <span
                      class="competition__countdown js-slot-countdown"
                      hidden
                    >
                      {dict.startsIn}{' '}
                      <span class="competition__countdown-value js-slot-countdown-value" />
                    </span>
                  )}
                </CompetitionLinks>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
    <p class="note">
      {dict.timeZoneNote} <span class="js-time-zone">Europe/Warsaw</span>
    </p>
  </section>

  <PastWinners lang={lang} event={event} />

  {hills.length > 0 && (
    <section class="section" aria-labelledby="hill-title">
      <h3 class="section__title" id="hill-title">
        {dict.hillSection}
      </h3>
      <div class="hills">
        {hills.map((hill) => (
          <HillCard lang={lang} hill={hill} />
        ))}
      </div>
    </section>
  )}

  {programs.length > 0 && (
    <section class="section" aria-labelledby="sheet-title">
      <h3 class="section__title" id="sheet-title">
        {dict.handwrittenProgram}
      </h3>
      <ul class="gallery">
        {programs.map((program) => (
          <ProgramCard lang={lang} program={program} title={event.city} />
        ))}
      </ul>
    </section>
  )}

  {event.officials.length > 0 && (
    <section class="section" aria-labelledby="officials-title">
      <h3 class="section__title" id="officials-title">
        {dict.officials}
      </h3>
      <ul class="people">
        {event.officials.map((official) => (
          <li class="people__item">
            <span class="people__name">
              {getNationFlag(official.nation)} {official.name}
              <span class="people__nation">{official.nation}</span>
            </span>
            <span class="people__role">
              {dict.officialRoles[official.role]}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>
