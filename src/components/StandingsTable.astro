---
import { t, type Lang } from '../i18n';
import { nationPath } from '../lib/paths';
import Avatar from './Avatar.astro';
import { getAthleteUrl, getNationFlag } from '../lib/links';
import type { Standings } from '../lib/schema';

interface Props {
  lang: Lang;
  standings: Standings;
}

const { lang, standings } = Astro.props;
const dict = t(lang);
---

<div class="table-tools">
  <button class="button js-home-only" type="button" aria-pressed="false">
    🇵🇱 {dict.onlyPoles}
  </button>
</div>
<div class="table-wrap">
  <table class="table">
    <thead>
      <tr>
        <th class="table__cell table__cell--number" scope="col">
          {dict.rank}
        </th>
        <th class="table__cell" scope="col">
          {dict.athlete}
        </th>
        <th class="table__cell" scope="col">
          {dict.country}
        </th>
        <th class="table__cell table__cell--number" scope="col">
          {dict.points}
        </th>
      </tr>
    </thead>
    <tbody>
      {standings.rows.map((row) => (
        <tr
          class:list={[
            'table__row',
            row.nation === 'POL' && 'table__row--home',
          ]}
        >
          <td class="table__cell table__cell--number">{row.rank}</td>
          <td class="table__cell">
            <span class="person">
              <Avatar name={`${row.givenName} ${row.familyName}`} />
              <a class="table__link" href={getAthleteUrl(row.fisCompetitorId)}>
                {row.givenName} {row.familyName}
              </a>
            </span>
          </td>
          <td class="table__cell">
            <a class="table__link" href={nationPath(lang, row.nation)}>
              {`${getNationFlag(row.nation)} ${row.nation}`}
            </a>
          </td>
          <td class="table__cell table__cell--number table__cell--strong">
            {row.points}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<p class="note">
  {standings.updatedAt && (
    <>
      {dict.standingsUpdated} {standings.updatedAt} ·{' '}
    </>
  )}
  <a class="link" href={standings.sourceUrl}>
    {dict.standingsSource}
  </a>
</p>
