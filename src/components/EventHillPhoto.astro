---
import { Image } from 'astro:assets';
import { getHillPhoto, hillOfEvent } from '../lib/hills';
import type { SeasonEvent } from '../lib/schema';

interface Props {
  event: SeasonEvent;
  class: string;
}

const { event, class: className } = Astro.props;
const hill = hillOfEvent(event);
const photo = hill ? getHillPhoto(hill) : undefined;
---

{photo && (
  <Image
    class={className}
    src={photo}
    width={640}
    alt={hill?.name ?? event.city}
  />
)}
