---
import { t, type Lang } from '../i18n';
import { formatNumber, formatThousands } from '../lib/hills';
import { getNationFlag } from '../lib/links';
import type { Hill } from '../lib/schema';

interface Props {
  lang: Lang;
  hill: Hill;
}

const { lang, hill } = Astro.props;
const dict = t(lang);
const num = (value: number): string => formatNumber(value, lang);
const rows = [
  [dict.hillKPoint, `${num(hill.kPoint)} m`],
  [dict.hillHs, `${num(hill.hillSize)} m`],
  [
    dict.hillInrun,
    hill.inrunLength === null ? null : `${num(hill.inrunLength)} m`,
  ],
  [
    dict.hillTakeoff,
    hill.takeoffAngle === null ? null : `${num(hill.takeoffAngle)}°`,
  ],
  [
    dict.hillLanding,
    hill.landingAngle === null ? null : `${num(hill.landingAngle)}°`,
  ],
  [dict.hillOpened, hill.opened === null ? null : String(hill.opened)],
  [
    dict.hillRebuilt,
    hill.lastRebuilt === null ? null : String(hill.lastRebuilt),
  ],
  [
    dict.hillCapacity,
    hill.capacity === null
      ? null
      : `${dict.about} ${formatThousands(hill.capacity)}`,
  ],
].flatMap(([label, value]) => (label && value ? [{ label, value }] : []));
---

<article class="hill" data-hill={hill.slug}>
  <h4 class="hill__title">
    {hill.name} HS{hill.hillSize}
  </h4>
  {hill.record && (
    <p class="hill__record">
      <span class="hill__record-label">{dict.hillRecord}</span>
      <span class="hill__record-value">{num(hill.record.distance)} m</span>
      <span class="hill__record-holder">
        {getNationFlag(hill.record.nation)} {hill.record.athlete},{' '}
        {hill.record.date}
      </span>
    </p>
  )}
  <div class="table-wrap">
    <table class="table">
      <tbody>
        {rows.map((row) => (
          <tr class="table__row">
            <th class="table__cell table__cell--label" scope="row">
              {row.label}
            </th>
            <td class="table__cell table__cell--number table__cell--strong">
              {row.value}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <ul class="hill__facts">
    {hill.facts.map((fact) => (
      <li class="hill__fact">{fact[lang]}</li>
    ))}
  </ul>
  <p class="note">
    <a class="link" href={hill.sourceUrl}>
      {dict.hillSource}
    </a>
  </p>
</article>
