---
import Avatar from './Avatar.astro';
interface Props {
  name: string;
  url?: string | undefined;
}

const { name, url } = Astro.props;
---

<span class="person">
  <Avatar name={name} />
  {url ? (
    <a class="people__name people__name--link" href={url}>
      {name}
    </a>
  ) : (
    <span class="people__name">{name}</span>
  )}
</span>
