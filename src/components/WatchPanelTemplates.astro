---
import type { Lang } from '../i18n';
import { getChannelIds, getChannels, watchPanelId } from '../lib/links';
import type { Competition, Season, SeasonEvent } from '../lib/schema';
import WatchPanel from './WatchPanel.astro';

interface Props {
  lang: Lang;
  season: Season;
  items: { event: SeasonEvent; competition: Competition }[];
}

const { lang, season, items } = Astro.props;
// One panel per distinct channel set; cards clone it when first opened.
const panels = new Map(
  items
    .map(({ event, competition }) => ({
      id: watchPanelId(getChannelIds(season, event, competition)),
      channels: getChannels(season, event, competition),
    }))
    .filter((panel) => panel.channels.length > 0)
    .map((panel) => [panel.id, panel.channels]),
);
---

{[...panels].map(([id, channels]) => (
  <template id={id}>
    <WatchPanel lang={lang} channels={channels} standalone />
  </template>
))}
