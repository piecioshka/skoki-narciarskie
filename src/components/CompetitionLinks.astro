---
import { t, type Lang } from '../i18n';
import {
  getChannelIds,
  getChannels,
  getLiveUrl,
  getResultsUrl,
  watchPanelId,
} from '../lib/links';
import type { Competition, Season, SeasonEvent } from '../lib/schema';
import Icon from './Icon.astro';
import WatchPanel from './WatchPanel.astro';

interface Props {
  lang: Lang;
  season: Season;
  event: SeasonEvent;
  competition: Competition;
  // Moves where to watch below the other links and the default slot.
  broadcastsLast?: boolean;
  // The panel is left out and cloned from a shared <template> (see
  // WatchPanelTemplates) when first opened; without JS only the summary shows.
  sharedPanel?: boolean;
}

const {
  lang,
  season,
  event,
  competition,
  broadcastsLast = false,
  sharedPanel = false,
} = Astro.props;
const dict = t(lang);
const resultsUrl = getResultsUrl(competition);
const channels = getChannels(season, event, competition);
const panelId = sharedPanel
  ? watchPanelId(getChannelIds(season, event, competition))
  : undefined;
---

<div class:list={['links', broadcastsLast && 'links--broadcasts-last']}>
  {channels.length === 0 && (
    <p class="links__note links__note--broadcast">
      {competition.channels === undefined
        ? dict.broadcastUnknown
        : dict.broadcastNone}
    </p>
  )}
  {channels.length > 0 && (
    <details class="watch" data-watch-panel={panelId}>
      <summary class="button watch__summary">
        <Icon name="tv" />
        {dict.watchOptions}
        <span class="watch__channel-names">
          {channels.map((channel) => channel.name).join(', ')}
        </span>
        <Icon name="chevron-down" class="watch__chevron" />
      </summary>
      {!sharedPanel && <WatchPanel lang={lang} channels={channels} />}
    </details>
  )}
  <ul class="links__row">
    <li class="links__item links__item--live">
      <a class="button button--live" href={getLiveUrl(competition)}>
        <Icon name="activity" />
        {dict.liveResults}
      </a>
    </li>
    {(competition.documents ?? []).map((document) => (
      <li class="links__item links__item--document">
        <a class="button" href={document.url}>
          <Icon name="file-text" />
          {dict.documentLabels[document.label] ?? document.label} (PDF)
        </a>
      </li>
    ))}
    {resultsUrl && (
      <li class="links__item links__item--results">
        <a class="button" href={resultsUrl}>
          <Icon name="list" />
          {dict.results}
        </a>
      </li>
    )}
  </ul>
  <slot />
</div>
