---
import { t, type Lang } from '../i18n';
import {
  getBroadcasters,
  getChannels,
  getLiveUrl,
  getResultsUrl,
} from '../lib/links';
import type { Competition, Season, SeasonEvent } from '../lib/schema';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  season: Season;
  event: SeasonEvent;
  competition: Competition;
  // Moves where to watch below the other links and the default slot.
  broadcastsLast?: boolean;
}

const {
  lang,
  season,
  event,
  competition,
  broadcastsLast = false,
} = Astro.props;
const dict = t(lang);
const broadcasters = getBroadcasters(season, event, competition);
const resultsUrl = getResultsUrl(competition);
const channels = getChannels(season, event, competition);
---

<div class:list={['links', broadcastsLast && 'links--broadcasts-last']}>
  {broadcasters.length === 0 && (
    <p class="links__note links__note--broadcast">
      {competition.broadcasts === undefined
        ? dict.broadcastUnknown
        : dict.broadcastNone}
    </p>
  )}
  {channels.length > 0 && (
    <details class="watch">
      <summary class="button watch__summary">
        <Icon name="tv" />
        {dict.watchOptions}
        <span class="watch__channel-names">
          {channels.map((channel) => channel.name).join(', ')}
        </span>
        <Icon name="chevron-down" class="watch__chevron" />
      </summary>
      <div class="watch__panel">
        {channels.map((channel) => (
          <section class="watch__channel">
            <p class="watch__name">{channel.name}</p>
            <ul class="watch__services">
              {channel.options.map(
                (option) =>
                  option.type === 'online' && (
                    <li>
                      <a class="button watch__service" href={option.url}>
                        {option.name}
                        {option.free && (
                          <span class="watch__free">{dict.watchFree}</span>
                        )}
                      </a>
                    </li>
                  ),
              )}
            </ul>
            {channel.options.map(
              (option) =>
                option.type !== 'online' && (
                  <p class="watch__tv">
                    <Icon
                      name={
                        option.type === 'antenna'
                          ? 'radio-tower'
                          : 'satellite-dish'
                      }
                    />
                    {option.type === 'antenna'
                      ? dict.watchAntenna
                      : dict.watchPayTv}
                    {option.type === 'antenna' && (
                      <span class="watch__free">{dict.watchFree}</span>
                    )}
                  </p>
                ),
            )}
          </section>
        ))}
      </div>
    </details>
  )}
  <ul class="links__row">
    <li class="links__item links__item--live">
      <a class="button button--live" href={getLiveUrl(competition)}>
        <Icon name="activity" />
        {dict.liveResults}
      </a>
    </li>
    {(competition.documents ?? []).map((document) => (
      <li class="links__item links__item--document">
        <a class="button" href={document.url}>
          <Icon name="file-text" />
          {dict.documentLabels[document.label] ?? document.label} (PDF)
        </a>
      </li>
    ))}
    {resultsUrl && (
      <li class="links__item links__item--results">
        <a class="button" href={resultsUrl}>
          <Icon name="list" />
          {dict.results}
        </a>
      </li>
    )}
  </ul>
  <slot />
</div>
