---
import { t, type Lang } from '../i18n';
import { FIS_LIVE_URL, getBroadcasters, getResultsUrl } from '../lib/links';
import type { Competition, Season, SeasonEvent } from '../lib/schema';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  season: Season;
  event: SeasonEvent;
  competition: Competition;
}

const { lang, season, event, competition } = Astro.props;
const dict = t(lang);
const broadcasters = getBroadcasters(season, event);
---

<ul class="links">
  {broadcasters.map((broadcaster) => (
    <li class="links__item links__item--broadcast">
      <a
        class="button button--primary"
        href={broadcaster.url}
        title={`${dict.watch}: ${broadcaster.name}`}
      >
        <Icon name="tv" />
        {broadcaster.name}
      </a>
    </li>
  ))}
  {broadcasters.length === 0 && (
    <li class="links__item links__item--broadcast links__note">
      {dict.broadcastUnknown}
    </li>
  )}
  <li class="links__item links__item--live">
    <a class="button" href={FIS_LIVE_URL}>
      <Icon name="activity" />
      {dict.liveResults}
    </a>
  </li>
  <li class="links__item">
    <a class="button" href={getResultsUrl(competition)}>
      <Icon name="list" />
      {dict.results}
    </a>
  </li>
</ul>
