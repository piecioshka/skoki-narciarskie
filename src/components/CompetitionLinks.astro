---
import { t, type Lang } from '../i18n';
import {
  getBroadcasters,
  getChannels,
  getLiveUrl,
  getResultsUrl,
} from '../lib/links';
import type { Competition, Season, SeasonEvent } from '../lib/schema';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  season: Season;
  event: SeasonEvent;
  competition: Competition;
  // Moves broadcasts below the other links and the default slot.
  broadcastsLast?: boolean;
}

const {
  lang,
  season,
  event,
  competition,
  broadcastsLast = false,
} = Astro.props;
const dict = t(lang);
const broadcasters = getBroadcasters(season, event, competition);
const resultsUrl = getResultsUrl(competition);
const channels = getChannels(season, event, competition);
---

<div class:list={['links', broadcastsLast && 'links--broadcasts-last']}>
  <ul class="links__row links__row--broadcast">
    {broadcasters.map((broadcaster) => (
      <li class="links__item links__item--broadcast">
        <a
          class="button button--primary"
          href={broadcaster.url}
          title={`${dict.watch}: ${broadcaster.name}`}
        >
          <Icon name="tv" />
          {broadcaster.name}
        </a>
      </li>
    ))}
    {broadcasters.length === 0 && (
      <li class="links__item links__item--broadcast links__note">
        {competition.broadcasts === undefined
          ? dict.broadcastUnknown
          : dict.broadcastNone}
      </li>
    )}
  </ul>
  {channels.length > 0 && (
    <details class="watch">
      <summary class="watch__summary">{dict.watchOptions}</summary>
      <div class="watch__channels">
        {channels.map((channel) => (
          <section class="watch__channel">
            <p class="watch__name">{channel.name}</p>
            <ul class="watch__list">
              {channel.options.map((option) => (
                <li class="watch__item">
                  {option.type === 'online' ? (
                    <a href={option.url}>{option.name}</a>
                  ) : option.type === 'antenna' ? (
                    dict.watchAntenna
                  ) : (
                    dict.watchPayTv
                  )}
                  {(option.type === 'antenna' ||
                    (option.type === 'online' && option.free)) && (
                    <span class="watch__free">{dict.watchFree}</span>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </details>
  )}
  <ul class="links__row">
    <li class="links__item links__item--live">
      <a class="button button--live" href={getLiveUrl(competition)}>
        <Icon name="activity" />
        {dict.liveResults}
      </a>
    </li>
    {(competition.documents ?? []).map((document) => (
      <li class="links__item links__item--document">
        <a class="button" href={document.url}>
          <Icon name="file-text" />
          {dict.documentLabels[document.label] ?? document.label} (PDF)
        </a>
      </li>
    ))}
    {resultsUrl && (
      <li class="links__item">
        <a class="button" href={resultsUrl}>
          <Icon name="list" />
          {dict.results}
        </a>
      </li>
    )}
  </ul>
  <slot />
</div>
