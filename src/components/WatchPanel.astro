---
import { t, type Lang } from '../i18n';
import type { Channel } from '../lib/schema';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  channels: Channel[];
  // Set when the panel is the content of a <template>.
  standalone?: boolean;
}

const { lang, channels, standalone = false } = Astro.props;
const dict = t(lang);
---

<div class="watch__panel">
  {channels.map((channel) => (
    <section class="watch__channel">
      <p class="watch__name">{channel.name}</p>
      <ul class="watch__services">
        {channel.options.map(
          (option) =>
            option.type === 'online' && (
              <li>
                <a class="button watch__service" href={option.url}>
                  {option.name}
                  {option.free && (
                    <span class="watch__free">{dict.watchFree}</span>
                  )}
                </a>
              </li>
            ),
        )}
      </ul>
      {channel.options.map(
        (option) =>
          option.type !== 'online' && (
            <p class="watch__tv">
              <Icon
                name={
                  option.type === 'antenna' ? 'radio-tower' : 'satellite-dish'
                }
                standalone={standalone}
              />
              {option.type === 'antenna' ? dict.watchAntenna : dict.watchPayTv}
              {option.type === 'antenna' && (
                <span class="watch__free">{dict.watchFree}</span>
              )}
            </p>
          ),
      )}
    </section>
  ))}
</div>
