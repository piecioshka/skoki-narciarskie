---
import type { Tournament } from '../lib/schema';

interface Props {
  tournament: Tournament;
}

// The banner is drawn, not photographed: colors come from the flags of the
// host countries and every flight path stands for one hill or one round.
const { tournament } = Astro.props;
const { from, to, accent, marks } = tournament.banner;
const gradientId = `banner-${tournament.slug}`;
const takeoff = { x: 92, y: 62 };
const flights = Array.from({ length: marks }, (_, index) => {
  const landingX = 190 + (index * 170) / Math.max(1, marks - 1);
  const landingY = 150 - (landingX - 190) * 0.08;
  const peakX = (takeoff.x + landingX) / 2;
  const peakY = 34 - index * 3;

  return {
    path: `M${takeoff.x} ${takeoff.y} Q${peakX} ${peakY} ${landingX} ${landingY}`,
    x: landingX,
    y: landingY,
  };
});
---

<svg
  class="banner"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 400 160"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <defs>
    <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={from}></stop>
      <stop offset="1" stop-color={to}></stop>
    </linearGradient>
  </defs>
  <rect width="400" height="160" fill={`url(#${gradientId})`}></rect>
  <path
    d="M0 22 C40 26 70 44 92 62 L92 70 C130 118 190 150 400 134 L400 160 L0 160 Z"
    fill="#ffffff"
    fill-opacity="0.16"
  ></path>
  <path
    d="M0 22 C40 26 70 44 92 62"
    fill="none"
    stroke="#ffffff"
    stroke-opacity="0.7"
    stroke-width="3"
    stroke-linecap="round"
  ></path>
  {flights.map((flight) => (
    <>
      <path
        d={flight.path}
        fill="none"
        stroke={accent}
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray="1 6"
      />
      <circle cx={flight.x} cy={flight.y} r="4" fill={accent} />
    </>
  ))}
</svg>
