---
import { Image } from 'astro:assets';
import { getCountryName, type Lang } from '../i18n';
import { getFlag } from '../lib/links';
import { getHillPhoto, getHillProfileSlug } from '../lib/hills';
import { hillPath } from '../lib/paths';
import type { Hill } from '../lib/schema';

interface Props {
  lang: Lang;
  hill: Hill;
}

const { lang, hill } = Astro.props;
const photo = getHillPhoto(hill);
---

<li>
  <a
    class="tournament-card"
    href={hillPath(lang, getHillProfileSlug(hill))}
    data-hill={hill.slug}
  >
    {photo ? (
      <Image class="hill-card__image" src={photo} width={480} alt="" />
    ) : (
      <div class="hill-card__placeholder" />
    )}
    <div class="tournament-card__body">
      <h3 class="tournament-card__title">{hill.name}</h3>
      <p class="tournament-card__text">
        {`${getFlag(hill.countryCode)} ${hill.city}, ${getCountryName(lang, hill.countryCode)}`}
      </p>
      <p class="tournament-card__meta">
        <span class="badge">HS{hill.hillSize}</span>
        <span class="phase">K{hill.kPoint}</span>
      </p>
    </div>
  </a>
</li>
