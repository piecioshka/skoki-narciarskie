  {
    "slug": "planica7",
    "name": "Planica7",
    "firstEdition": 2018,
    "status": "active",
    "hosts": ["Planica"],
    "events": {
      "2026-2027": ["planica"]
    },
    "description": {
      "pl": "Czterodniowy turniej lotów narciarskich na Letalnicy w Planicy, rozgrywany na zakończenie sezonu Pucharu Świata od sezonu 2017/2018.",
      "en": "A four-day ski flying tournament at Letalnica in Planica, held at the end of the World Cup season since 2017/2018."
    },
    "format": {
      "pl": "Liczy się suma not z siedmiu serii: jednej serii kwalifikacyjnej oraz po dwóch seriach w dwóch konkursach indywidualnych i w konkursie drużynowym. Nagroda jest przyznawana, gdy odbędą się co najmniej cztery z siedmiu serii.",
      "en": "The total score from seven rounds counts: one qualification round and two rounds each in two individual competitions and in the team competition. The prize is awarded when at least four of the seven rounds take place."
    },
    "prize": {
      "pl": "W pierwszej edycji zwycięzca otrzymał 20 tys. franków szwajcarskich, w sezonie 2025/2026 było to 20 tys. euro.",
      "en": "In the first edition the winner received 20,000 Swiss francs; in the 2025/2026 season it was 20,000 euros."
    },
    "statusNote": {
      "pl": "W sezonie 2026/2027 turniej zaplanowano na 18-21 marca.",
      "en": "In the 2026/2027 season the tournament is scheduled for 18-21 March."
    },
