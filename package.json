{
  "private": true,
  "type": "module",
  "name": "skoki-narciarskie",
  "description": "Ski Jumping World Cup schedule with links to broadcasts and live results",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Piotr Kowalski",
    "url": "https://piecioshka.pl/"
  },
  "scripts": {
    "clear": "rm -rf dist/ .astro/ coverage/ playwright-report/ test-results/",
    "dev": "astro dev --host 127.0.0.1 --port $(FORCE_COLOR=0 detect-port 3000)",
    "build": "astro build",
    "build:e2e": "BUILD_NOW=2026-11-16T00:00:00Z astro build",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run e2e",
    "prepare": "husky",
    "standings": "node scripts/update-standings.ts",
    "import-season": "node scripts/import-season.ts",
    "careers": "node scripts/update-careers.ts",
    "documents": "node scripts/update-documents.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "astro": "^7.4.12",
    "leaflet": "^1.9.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "detect-port": "^2.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.15"
  }
}
